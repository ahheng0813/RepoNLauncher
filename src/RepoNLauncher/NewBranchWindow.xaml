<Window x:Class="RepoNLauncher.NewBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        Title="New branch - Repo'N'Launcher" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Window.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="New branch" FontSize="17" FontWeight="SemiBold"/>

        <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                 AutomationProperties.Name="Branch name"/>
        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="For example feature/login-page. Spaces become dashes."/>

        <TextBlock Text="START FROM" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
        <ComboBox Height="32" ItemsSource="{Binding StartPoints}" SelectedItem="{Binding StartPoint}" AutomationProperties.Name="Start from">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas"/>
                        <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource Text.Muted}" FontSize="11"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding StartHint}" Style="{StaticResource Note}" Margin="0,6,0,0"/>

        <CheckBox Content="Switch to it now" IsChecked="{Binding SwitchTo}" Margin="0,14,0,0"/>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="12.5" Margin="0,14,0,0"
                   Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True"/>
            <Button Content="Create branch" Style="{StaticResource Button.Primary}" Margin="0" IsDefault="True"
                    Command="{Binding CreateCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
