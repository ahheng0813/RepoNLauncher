<Window x:Class="RepoNLauncher.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        xmlns:services="clr-namespace:RepoNLauncher.Services"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        Title="Repo'N'Launcher" Height="800" Width="1200"
        WindowStartupLocation="Manual"
        Background="{StaticResource Bg.App}"
        FontFamily="{StaticResource Font.Mono}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- DataContext: the SiteBrowserViewModel, for the saved sites every browser window shows. The toolbar acts on the tab picked. -->
    <Window.Resources>
        <!-- A saved site in the bar under the address: its name, the address in its tooltip -->
        <Style x:Key="SiteChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A saved site's menu, in the bar and on the start page; its DataContext is the site -->
        <ContextMenu x:Key="SiteMenu">
            <MenuItem Header="{x:Static services:DefaultBrowser.OpenLabel}" Click="SiteMenuOpenInDefaultBrowser_Click"/>
            <MenuItem Header="Edit…" Click="SiteMenuEdit_Click"/>
            <MenuItem Header="Remove" Click="SiteMenuRemove_Click"/>
        </ContextMenu>

        <conv:EnumEqualsConverter x:Key="EnumEquals"/>

        <!-- The ad blocker's shield: the shield, with how many it blocked on the page beside it -->
        <Style x:Key="ShieldButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="7,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- × on a tab -->
        <Style x:Key="TabClose" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Width="20" Height="20">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tab (its DataContext is the BrowserTab): the site's icon, turning while the page loads, its title, and × -->
        <DataTemplate x:Key="TabHeader">
            <Grid x:Name="Root" Background="Transparent" Height="34" ToolTip="{Binding Title}">
                <Border x:Name="Bd" BorderThickness="1,1,1,0" BorderBrush="Transparent" Background="Transparent"/>
                <DockPanel Margin="10,0,6,0">
                    <Button x:Name="Close" DockPanel.Dock="Right" Style="{StaticResource TabClose}" VerticalAlignment="Center"
                            Visibility="Hidden" ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab" Click="TabClose_Click"/>
                    <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Globe" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Visibility="Collapsed"
                                   Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="Icon" Source="{Binding Favicon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Ellipse x:Name="Spinner" Width="14" Height="14" Stroke="{StaticResource Accent}" StrokeThickness="2"
                                 StrokeDashArray="6 13" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}"/>
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Globe" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.PanelAlt}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text.Primary}"/>
                </MultiDataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Close" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Elevated}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text.Primary}"/>
                    <Setter TargetName="Close" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Globe" Property="Visibility" Value="Collapsed"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Spin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Spinner"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Spin"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A tab's menu; its PlacementTarget's DataContext is the tab -->
        <ContextMenu x:Key="TabMenu">
            <MenuItem Header="New tab to the right" Click="TabMenuNewTab_Click"/>
            <MenuItem Header="Reload" Click="TabMenuReload_Click"/>
            <MenuItem Header="Duplicate" Click="TabMenuDuplicate_Click"/>
            <MenuItem Header="Move to new window" Click="TabMenuMoveToNewWindow_Click"/>
            <Separator/>
            <MenuItem Header="Close tab" InputGestureText="Ctrl+W" Click="TabMenuClose_Click"/>
            <MenuItem Header="Close other tabs" Click="TabMenuCloseOthers_Click"/>
            <MenuItem Header="Close tabs to the right" Click="TabMenuCloseRight_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- In full screen the toolbar hides; touching the top edge of the screen (this strip) brings it back -->
        <Border x:Name="RevealStrip" Grid.Row="0" Height="4" Background="Transparent" Visibility="Collapsed"
                MouseEnter="RevealStrip_MouseEnter"/>

        <StackPanel x:Name="Toolbar" Grid.Row="0" MouseLeave="Toolbar_MouseLeave">
            <!-- The tabs: click one to show it, drag it along the tabs to move it, out of the window for a window of its own,
                 or onto another browser window's tabs to join them; + (Ctrl+T), or double-clicking past the tabs, opens one -->
            <Grid x:Name="TabBar" Background="{StaticResource Bg.Console}">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Border.Subtle}"/>
                <controls:BrowserTabPanel x:Name="TabStrip" Margin="6,6,6,0" Background="Transparent" ClipToBounds="True"
                                          MouseLeftButtonDown="TabStrip_MouseLeftButtonDown">
                    <Button Content="&#xE710;" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0" ToolTip="New tab (Ctrl+T)"
                            AutomationProperties.Name="New tab" Click="NewTab_Click"/>
                </controls:BrowserTabPanel>
            </Grid>

            <Border Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1"
                    Padding="8,6">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="BackButton" Content="&#xE72B;" Style="{StaticResource Button.Ghost}" IsEnabled="False"
                                ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" Click="Back_Click"/>
                        <Button x:Name="ForwardButton" Content="&#xE72A;" Style="{StaticResource Button.Ghost}" IsEnabled="False"
                                ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" Click="Forward_Click"/>
                        <Button x:Name="ReloadButton" Content="&#xE72C;" Style="{StaticResource Button.Ghost}"
                                ToolTip="Reload (F5)" AutomationProperties.Name="Reload" Click="Reload_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="&#xE8A7;" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0"
                                ToolTip="New window (Ctrl+N; Ctrl+Shift+N for an incognito one)" AutomationProperties.Name="New window"
                                Click="NewWindow_Click"/>
                        <Button Content="&#xE774;" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0"
                                ToolTip="Open this page in your default browser" AutomationProperties.Name="Open in default browser"
                                Click="OpenInDefaultBrowser_Click"/>
                        <Button Content="&#xEC7A;" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0"
                                ToolTip="Developer tools (F12)" AutomationProperties.Name="Developer tools" Click="DevTools_Click"/>
                        <Button x:Name="NextScreenButton" Content="&#xE7F4;" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0"
                                ToolTip="Move to the next screen" AutomationProperties.Name="Move to the next screen"
                                Click="NextScreen_Click"/>
                        <controls:PinOnTopButton Margin="0,0,2,0"/>
                        <Button Content="&#xE740;" Style="{StaticResource Button.Ghost}"
                                ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen" Click="FullScreen_Click"/>
                    </StackPanel>

                    <!-- The ad blocker: lit while it blocks on the page, with how many it has blocked; opens its options -->
                    <Button x:Name="ShieldButton" DockPanel.Dock="Right" Style="{StaticResource ShieldButton}" Margin="0,0,2,0"
                            AutomationProperties.Name="Ad blocker" Click="Shield_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ShieldGlyph" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ShieldCount" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>

                    <!-- Incognito: this window keeps nothing on this PC -->
                    <TextBlock x:Name="IncognitoBadge" DockPanel.Dock="Right" Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="4,0,8,0"
                               Visibility="Collapsed" ToolTip="Incognito: this window keeps no history, cookies or sign-ins on this PC"
                               AutomationProperties.Name="Incognito"/>

                    <!-- Saves the page (or edits it, once saved): lit while the page shown is a saved site -->
                    <Button x:Name="StarButton" DockPanel.Dock="Right" Content="&#xE734;" Style="{StaticResource Button.Ghost}"
                            Margin="0,0,6,0" IsEnabled="False" ToolTip="Save this site (Ctrl+D)"
                            AutomationProperties.Name="Save this site" Click="Star_Click"/>

                    <!-- The page's address; type another and press Enter to go there -->
                    <TextBox x:Name="Address" Margin="8,0,4,0" FontFamily="{StaticResource Font.Mono}" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Address or search" KeyDown="Address_KeyDown"
                             GotKeyboardFocus="Address_GotKeyboardFocus"/>
                </DockPanel>

                <!-- The saved sites, one click each; right-click one to open it in the default browser, edit or remove it -->
                <ItemsControl ItemsSource="{Binding SavedSites}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedSites.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SiteChip}" Click="SavedSite_Click" ToolTip="{Binding Url}"
                                    ContextMenu="{StaticResource SiteMenu}" AutomationProperties.Name="{Binding Name}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Border>
        </StackPanel>

        <!-- Shown instead of the page while the app's server doesn't answer yet -->
        <StackPanel x:Name="WaitingNote" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="Collapsed">
            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="WaitingText" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- Opened without a site (from the dashboard's header, or before the project has run): where to go -->
        <ScrollViewer x:Name="StartPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="760">
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Type an address above, such as localhost:3000, or what to search for, and press Enter."
                           Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="On a page, ☆ (Ctrl+D) saves it, to open it again from here or the bar under the address."
                           Foreground="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>

                <StackPanel Margin="0,28,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedSites.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="SAVED SITES" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding SavedSites}" HorizontalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" Padding="12,8"
                                        Click="SavedSite_Click" ContextMenu="{StaticResource SiteMenu}"
                                        ToolTip="{Binding Url}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Width="210">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}" Foreground="{StaticResource Text.Muted}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The tabs' pages; only the tab picked shows its own -->
        <Grid x:Name="WebHost" Grid.Row="1"/>

        <!-- Saving a site, or editing a saved one: its name and address. A window of its own, so it shows over the page. -->
        <Popup x:Name="SitePopup" Placement="Custom" AllowsTransparency="True" StaysOpen="False"
               Opened="SitePopup_Opened" Closed="SitePopup_Closed">
            <Border Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Strong}"
                    BorderThickness="1" Padding="14,12" Width="360">
                <StackPanel>
                    <TextBlock x:Name="SitePopupHeading" Text="SAVED SITE" Foreground="{StaticResource Text.Secondary}"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SiteName" AutomationProperties.Name="Saved site's name" KeyDown="SiteEditor_KeyDown"/>
                    <TextBlock Text="Address" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                    <TextBox x:Name="SiteAddress" FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="Saved site's address"
                             KeyDown="SiteEditor_KeyDown"/>
                    <TextBlock x:Name="SiteAddressError" Foreground="{StaticResource Danger}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Remove" Style="{StaticResource Button.Danger}" Click="RemoveSite_Click"
                                ToolTip="Take this site off the saved sites"/>
                        <Button Content="Done" Style="{StaticResource Button.Primary}" Margin="0" Click="DoneSite_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- The ad blocker's options, under the shield: on or off, how strong, and pausing it on the page's site -->
        <Popup x:Name="ShieldPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="False"
               PlacementTarget="{Binding ElementName=ShieldButton}">
            <Border Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Strong}"
                    BorderThickness="1" Padding="14,12" Width="380" DataContext="{Binding AdBlocker}">
                <StackPanel>
                    <TextBlock Text="AD BLOCKER" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,10"/>
                    <CheckBox Content="Block ads" IsChecked="{Binding IsEnabled}" Click="ShieldOption_Click"/>
                    <TextBlock x:Name="ShieldStatus" Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsEnabled}">
                        <TextBlock Text="Strength" Style="{StaticResource FieldLabel}"/>
                        <RadioButton GroupName="ShieldLevel" Click="ShieldOption_Click" Margin="0,2,0,6"
                                     IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" AutomationProperties.Name="Light">
                            <StackPanel>
                                <TextBlock Text="Light"/>
                                <TextBlock Style="{StaticResource ChoiceNote}" Text="Ad servers only. Pages keep their layout, with gaps where ads were."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="ShieldLevel" Click="ShieldOption_Click" Margin="0,0,0,6"
                                     IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}" AutomationProperties.Name="Balanced">
                            <StackPanel>
                                <TextBlock Text="Balanced"/>
                                <TextBlock Style="{StaticResource ChoiceNote}" Text="Ads and trackers, with the spaces left for ads hidden."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="ShieldLevel" Click="ShieldOption_Click"
                                     IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Strict}" AutomationProperties.Name="Strict">
                            <StackPanel>
                                <TextBlock Text="Strict"/>
                                <TextBlock Style="{StaticResource ChoiceNote}"
                                           Text="Also cookie banners, social widgets, pop-ups opened without a click, and more servers. Can break some sites."/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="PauseButton" DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Margin="0"
                                Click="Pause_Click"/>
                        <Button Content="Settings…" Style="{StaticResource Button.Secondary}" Margin="0" HorizontalAlignment="Right"
                                Click="ShieldSettings_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
