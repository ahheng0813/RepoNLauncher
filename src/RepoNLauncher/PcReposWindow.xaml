<Window x:Class="RepoNLauncher.PcReposWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:vm="clr-namespace:RepoNLauncher.ViewModels"
        Title="Repos on this PC - Repo'N'Launcher" Width="1000" Height="700" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>

        <!-- One segment of the All / Mine / Others switch. Its text follows the button's Foreground. -->
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,6" Margin="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Muted}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTabText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>

        <Style x:Key="FilterTabCount" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:PcRepoViewModel}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="10,8" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsEnabled="{Binding IsOnDashboard, Converter={StaticResource InverseBoolean}}"/>
                    <StackPanel Grid.Column="1" ToolTip="{Binding Path}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                            <Border Background="{StaticResource Bg.PanelAlt}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsOnDashboard, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="On dashboard" FontSize="10.5" Foreground="{StaticResource Text.Secondary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Private repo"
                                   Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding GitHubName}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="3" x:Name="Chip" CornerRadius="10" Padding="10,2" MinWidth="64" VerticalAlignment="Center"
                            Background="{StaticResource Bg.PanelAlt}">
                        <TextBlock x:Name="ChipText" Text="{Binding OwnershipLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Bg.Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Ownership}" Value="Mine">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Accent.Muted}"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Accent.Hover}"/>
                    <Setter TargetName="Chip" Property="ToolTip" Value="Owned by your GitHub account"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ownership}" Value="Others">
                    <Setter TargetName="Chip" Property="Background" Value="#14313A"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Cyan}"/>
                    <Setter TargetName="Chip" Property="ToolTip" Value="Owned by another GitHub account or organization (the name before the slash)"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ownership}" Value="NoAccess">
                    <Setter TargetName="Chip" Property="Background" Value="#3A3020"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter TargetName="Chip" Property="ToolTip" Value="GitHub doesn't show this repo to your account: it's someone else's private repo, or it was deleted"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Ownership}" Value="NotOnGitHub">
                    <Setter TargetName="Chip" Property="ToolTip" Value="This repo has no GitHub remote"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Repos on this PC" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Every git repo on this PC's drives, and who owns it on GitHub. Windows, Program Files, AppData, hidden and dot-folders, and dependency folders such as node_modules are skipped."/>
        </StackPanel>

        <!-- Shown when signed out: the scan needs GitHub to tell whose repos are whose -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding Account.Login, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Margin="0" Click="SignIn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GitHubMark}" Fill="White" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Sign in with GitHub" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Sign in to GitHub to check who owns each repo." VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="Scan PC" Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}"/>
            <Button DockPanel.Dock="Left" Content="Stop" Style="{StaticResource Button.Secondary}" Command="{Binding StopScanCommand}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            <ProgressBar DockPanel.Dock="Left" Width="70" IsIndeterminate="True" VerticalAlignment="Center" Margin="4,0,10,0"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{StaticResource Text.Secondary}" FontSize="12.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" ToolTip="{Binding Status}"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border DockPanel.Dock="Left" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="9">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllFilter" Style="{StaticResource FilterTab}" ToolTip="Every repo found"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="All" Style="{StaticResource FilterTabText}"/>
                            <TextBlock Text="{Binding Repos.Count}" Style="{StaticResource FilterTabCount}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MineFilter" Style="{StaticResource FilterTab}" ToolTip="Repos your GitHub account owns"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Mine}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mine" Style="{StaticResource FilterTabText}"/>
                            <TextBlock Text="{Binding MineCount}" Style="{StaticResource FilterTabCount}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OthersFilter" Style="{StaticResource FilterTab}" ToolTip="Repos other people or organizations own"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Others}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Others" Style="{StaticResource FilterTabText}"/>
                            <TextBlock Text="{Binding OthersCount}" Style="{StaticResource FilterTabCount}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            <CheckBox Content="Select all shown" IsChecked="{Binding AllShownChecked, Mode=TwoWay}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Tick every repo in this list that isn't on the dashboard yet"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding CheckedCount, StringFormat='{}{0} selected'}" Foreground="{StaticResource Text.Secondary}"
                       FontSize="12.5" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="Close_Click"/>
                <Button Content="Add to dashboard" Style="{StaticResource Button.Primary}" Margin="0"
                        Command="{Binding AddCheckedToDashboardCommand}"/>
            </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="10" Padding="6">
            <Grid>
                <TextBlock Text="No repos to show." Foreground="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=RepoList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="RepoList" ItemsSource="{Binding VisibleRepos}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
</Window>
