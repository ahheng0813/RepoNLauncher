<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RepoNLauncher.Controls"
                    xmlns:conv="clr-namespace:RepoNLauncher.Converters">

    <!-- Command Prompt look: the console's colors, one monospace font, square corners and thin box lines, and inverse
         video (text on an Accent block) for what's primary or selected.
         The colors are in Palette.Dark.xaml and Palette.Light.xaml, swapped by Services\ThemeService.cs, so they're
         always DynamicResource: a StaticResource would keep the palette the app started with. -->

    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

