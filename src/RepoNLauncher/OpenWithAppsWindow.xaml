<Window x:Class="RepoNLauncher.OpenWithAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open-in apps - Repo'N'Launcher" Width="860" Height="460" MinWidth="620" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Open-in apps" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="These appear under OPEN IN for every project. In Arguments, {path} is replaced with the project's folder, and the app starts in that folder (handy for terminals)."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="+ Add app" Style="{StaticResource Button.Secondary}" Click="Add_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True"/>
                <Button Content="Save" Style="{StaticResource Button.Primary}" Margin="0" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="10" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAME" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="PROGRAM" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="ARGUMENTS" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="12"/>
                </Grid>

                <Grid>
                    <TextBlock Text="No apps yet. Press + Add app and pick the program, e.g. Cursor.exe or a JetBrains IDE."
                               Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=AppList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AppList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DockPanel Grid.Column="1" Margin="0,0,8,0">
                                            <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Button.Secondary}"
                                                    Margin="6,0,0,0" Padding="10,6" Click="Browse_Click"/>
                                            <TextBox FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center"
                                                     Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <TextBox Grid.Column="2" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center"
                                                 Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="3" Content="✕" ToolTip="Remove this app" Style="{StaticResource Button.Icon}"
                                                HorizontalAlignment="Right" Click="Remove_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
