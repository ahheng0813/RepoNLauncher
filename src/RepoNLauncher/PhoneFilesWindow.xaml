<Window x:Class="RepoNLauncher.PhoneFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        xmlns:vm="clr-namespace:RepoNLauncher.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1180" Height="660" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>

        <!-- A Segoe MDL2 glyph that stays lit while it's on: the views, and the preview pane -->
        <Style x:Key="GlyphToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,5">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Muted}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
        </Style>

        <!-- A place beside the files: its icon, then its name -->
        <Style x:Key="PlaceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A folder of the path above the files -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="6,4">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Accent.Hover}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The theme's rows, showing which are selected -->
        <Style x:Key="FileRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="4,5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent.Muted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The icon view: a tile per file, the picture or video's own thumbnail once it's made, its icon till then -->
        <ItemsPanelTemplate x:Key="TilePanel">
            <!-- Each tile's margin and padding (12), picture (96) and two lines of name (30) -->
            <controls:VirtualizingTilePanel TileWidth="112" TileHeight="140"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="FileTile" DataType="{x:Type vm:PhoneFileItem}">
            <StackPanel Loaded="Tile_Loaded" Unloaded="Tile_Unloaded" ToolTip="{Binding Name}">
                <Grid Width="88" Height="88" Margin="0,2,0,6">
                    <TextBlock Text="{Binding Glyph}" FontSize="44" HorizontalAlignment="Center"
                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="86" MaxHeight="86"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <!-- A video's thumbnail is marked as one -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" CornerRadius="3" Padding="4,2"
                            Background="#B0000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsVideo}" Value="True"/>
                                            <Condition Binding="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}" Value="Visible"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"/>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30" Margin="4,0"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="FileTileItem" TargetType="ListViewItem">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ToggleButton DockPanel.Dock="Right" Content="&#xE8A0;" Style="{StaticResource GlyphToggle}" Margin="10,0,0,0"
                          IsChecked="{Binding ShowPreview}" ToolTip="Preview pane (Alt+P)" AutomationProperties.Name="Preview pane"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0">
                <RadioButton Content="&#xE8FD;" Style="{StaticResource GlyphToggle}" ToolTip="Details" AutomationProperties.Name="Details"
                             IsChecked="{Binding View, Converter={StaticResource EnumEquals}, ConverterParameter=Details}"/>
                <RadioButton Content="&#xF0E2;" Style="{StaticResource GlyphToggle}" Margin="2,0,0,0" ToolTip="Medium icons"
                             AutomationProperties.Name="Medium icons"
                             IsChecked="{Binding View, Converter={StaticResource EnumEquals}, ConverterParameter=Icons}"/>
            </StackPanel>
            <CheckBox DockPanel.Dock="Right" Content="Hidden files" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center"
                      Margin="14,0,0,0" ToolTip="Show files and folders whose names start with a full stop"/>
            <Button DockPanel.Dock="Right" Content="&#xE72C;" Style="{StaticResource Button.Ghost}" Margin="0"
                    Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh"/>
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- How the last thing went, the work under way, and what's selected -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Foreground="{StaticResource Text.Muted}" FontSize="12"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Stop" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" Padding="12,3"
                    Command="{Binding StopCopyingCommand}" ToolTip="Stop copying, and remove what it left half copied"
                    Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"/>
            <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="70" VerticalAlignment="Center" Margin="10,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <Button DockPanel.Dock="Right" Content="Show in folder" Style="{StaticResource TextLink}" VerticalAlignment="Center"
                    Margin="10,0,0,0" Command="{Binding ShowSavedCommand}"
                    Visibility="{Binding CanShowSaved, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Send files here…" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                    Command="{Binding ChooseFilesToSendCommand}" ToolTip="Copy files from this PC into the folder shown. You can also drop them on the list."/>
            <Button Content="Send a folder…" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                    Command="{Binding ChooseFolderToSendCommand}" ToolTip="Copy folders from this PC, with everything in them, into the folder shown"/>
            <Button Content="Save to PC…" Style="{StaticResource Button.Secondary}" Margin="0,0,22,0"
                    Command="{Binding SaveToPcCommand}" ToolTip="Copy what's selected to a folder on this PC"/>
            <Button Content="New folder" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Command="{Binding StartNewFolderCommand}"/>
            <Button Content="Rename" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Command="{Binding StartRenameCommand}"
                    ToolTip="Rename what's selected (F2)"/>
            <Button Content="Delete" Style="{StaticResource Button.Secondary}" Command="{Binding DeleteCommand}"
                    ToolTip="Delete what's selected from the phone, for good (Delete)"/>
        </WrapPanel>

        <!-- A name for a new folder, or a new name -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                Visibility="{Binding IsNaming, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                        Command="{Binding CancelNameCommand}"/>
                <Button DockPanel.Dock="Right" Content="{Binding NamingAction}" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                        Command="{Binding ConfirmNameCommand}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding NamingLabel}" Foreground="{StaticResource Text.Secondary}" FontSize="12.5"
                           VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="NameBox" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" KeyDown="NameBox_KeyDown"
                         AutomationProperties.Name="Name"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="14"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="340" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Places -->
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="PLACES" Style="{StaticResource SectionLabel}" Margin="8,4,0,8"/>
                <ItemsControl ItemsSource="{Binding Places}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PhonePlace}">
                            <Button Style="{StaticResource PlaceButton}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Path}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Width="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <DockPanel Grid.Column="1">
                <!-- Where the list is -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="&#xE74A;" Style="{StaticResource Button.Ghost}" Margin="0,0,6,0"
                            Command="{Binding UpCommand}" ToolTip="Up a folder (Backspace)" AutomationProperties.Name="Up"/>
                    <ItemsControl ItemsSource="{Binding PathSteps}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PathStep}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="9" Margin="2,1,2,0"
                                               Foreground="{StaticResource Text.Muted}"
                                               Visibility="{Binding HasArrow, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="{Binding Name}" Style="{StaticResource StepButton}" ToolTip="{Binding Path}"
                                            Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Path}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <Grid AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop" Background="Transparent">
                    <ListView x:Name="FileList" ItemsSource="{Binding Items}" SelectionMode="Extended" ItemContainerStyle="{StaticResource FileRow}"
                              AutomationProperties.Name="Files" SelectionChanged="FileList_SelectionChanged"
                              MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown" SizeChanged="FileList_SizeChanged"
                              GridViewColumnHeader.Click="FileList_HeaderClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="NameColumn" Width="300">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader x:Name="NameHeader" Content="Name" Tag="{x:Static vm:FileSort.Name}"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:PhoneFileItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Width="18" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="80">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader x:Name="SizeHeader" Content="Size" Tag="{x:Static vm:FileSort.Size}"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:PhoneFileItem}">
                                            <TextBlock Text="{Binding Size}" Foreground="{StaticResource Text.Secondary}" FontSize="12.5"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="150">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader x:Name="ModifiedHeader" Content="Modified" Tag="{x:Static vm:FileSort.Modified}"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:PhoneFileItem}">
                                            <TextBlock Text="{Binding Modified}" Foreground="{StaticResource Text.Secondary}" FontSize="12.5"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Kind" Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:PhoneFileItem}">
                                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Text.Muted}" FontSize="12.5"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" Margin="1,37,1,0"
                                 Visibility="{Binding IsListing, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ListNote}" Foreground="{StaticResource Text.Muted}" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,40,30,0"
                               IsHitTestVisible="False" Visibility="{Binding ListNote, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="2" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Focusable="False" ToolTip="Drag to resize the preview"/>

            <!-- What's selected, bigger -->
            <Border x:Name="PreviewPane" Grid.Column="3" DataContext="{Binding Preview}" Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"
                                Visibility="{Binding Title, Converter={StaticResource StringNotEmptyToVisibility}}">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="{Binding Details, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                        <TextBlock Text="{Binding Modified}" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="0,2,0,0"
                                   Visibility="{Binding Modified, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding Note, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                        <Button Content="Open on this PC" Style="{StaticResource TextLink}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Item}" ToolTip="Copy it to this PC and open it with the app Windows has for it"
                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Margin="0,12,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                    <Grid>
                        <TextBlock Text="Select a file to preview it." Foreground="{StaticResource Text.Muted}" FontSize="12.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Nothing}"/>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="72" HorizontalAlignment="Center"
                                   Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVisibility}}"/>
                        <Image Source="{Binding Picture}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding MediaFile, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>

                        <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                Command="{Binding LoadMediaCommand}" ToolTip="Copy the video from the phone and play it here"
                                Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Preview the PDF" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,150,0,0" Command="{Binding LoadMediaCommand}"
                                Visibility="{Binding CanShowPdf, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- A video or PDF, in Edge -->
                        <wv2:WebView2 x:Name="MediaView" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
