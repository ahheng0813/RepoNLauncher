<Window x:Class="RepoNLauncher.AiUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:vm="clr-namespace:RepoNLauncher.ViewModels"
        Title="AI usage - Repo'N'Launcher" Width="1040" Height="720" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        </Style>

        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:AiToolCardViewModel}">
            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                    CornerRadius="10" Padding="18,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Name, sign-in state, link to the provider's own usage page -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="0" VerticalAlignment="Center"
                                    Tag="{Binding UsagePageUrl}" ToolTip="{Binding UsagePageUrl}" Click="OpenLink_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Usage page"/>
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="7,1,0,0"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="Tile" Width="36" Height="36" CornerRadius="9" Background="{StaticResource Accent}">
                                <TextBlock Text="{Binding Letter}" FontSize="16" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse x:Name="SignInDot" Width="7" Height="7" Fill="{StaticResource Success}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding SignInText}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Account}" Style="{StaticResource Muted}" Margin="48,6,0,0"
                                   Visibility="{Binding Account, Converter={StaticResource StringNotEmptyToVisibility}}"/>

                        <Border Background="{StaticResource Bg.PanelAlt}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                Visibility="{Binding SignInHint, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Sign in" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                        Tag="{Binding SignInCommand}" ToolTip="{Binding SignInCommand}" Click="SignIn_Click"
                                        Visibility="{Binding SignInCommand, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                                        Tag="{Binding InstallUrl}" ToolTip="{Binding InstallUrl}" Click="OpenLink_Click"
                                        Visibility="{Binding InstallUrl, Converter={StaticResource StringNotEmptyToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Install" Foreground="White"/>
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                                   VerticalAlignment="Center" Margin="7,1,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding SignInHint}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"/>
                            </DockPanel>
                        </Border>

                        <!-- Plan limits -->
                        <TextBlock Text="PLAN LIMITS" Style="{StaticResource SectionLabel}" Margin="0,20,0,10"/>
                        <ItemsControl ItemsSource="{Binding Limits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Row" Margin="0,0,0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Label}" FontSize="13"/>
                                        </DockPanel>
                                        <Grid Height="6" Margin="0,6,0,5">
                                            <Border Background="{StaticResource Bg.PanelAlt}" CornerRadius="3"/>
                                            <Border x:Name="Fill" Background="{StaticResource Accent}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Fraction}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="High">
                                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Full">
                                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LimitsNote}" Style="{StaticResource Muted}"/>

                        <!-- Token use from the session files on this PC -->
                        <TextBlock Text="ON THIS PC" Style="{StaticResource SectionLabel}" Margin="0,22,0,10"/>
                        <TextBlock x:Name="NoSessions" Text="{Binding NoSessionsText}" Style="{StaticResource Muted}" FontSize="12.5"
                                   Visibility="Collapsed"/>
                        <StackPanel x:Name="Sessions">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="66"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Requests" Style="{StaticResource HeaderCell}"/>
                                <TextBlock Grid.Column="2" Text="Input" Style="{StaticResource HeaderCell}"/>
                                <TextBlock Grid.Column="3" Text="Output" Style="{StaticResource HeaderCell}"/>
                                <TextBlock Grid.Column="4" Text="Cache" Style="{StaticResource HeaderCell}"
                                           ToolTip="Tokens read from or written to the prompt cache"/>
                                <TextBlock Grid.Column="5" Text="Total" Style="{StaticResource HeaderCell}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Periods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="66"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Requests}" Style="{StaticResource Cell}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Input}" Style="{StaticResource Cell}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Output}" Style="{StaticResource Cell}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Cache}" Style="{StaticResource Cell}"
                                                           ToolTip="{Binding CacheDetail}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Total}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="MODELS, LAST 7 DAYS" Style="{StaticResource SectionLabel}" Margin="0,18,0,10"/>
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Model}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                                                <Border Background="{StaticResource Bg.PanelAlt}" CornerRadius="3"/>
                                                <Border Background="{StaticResource Cyan}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Share}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding ShareText}" Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Tokens}" Style="{StaticResource Cell}"
                                                       Foreground="{StaticResource Text.Secondary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="Claude">
                    <Setter TargetName="Tile" Property="Background" Value="#C96442"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Codex">
                    <Setter TargetName="Tile" Property="Background" Value="#3B3F4A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSignedIn}" Value="False">
                    <Setter TargetName="SignInDot" Property="Fill" Value="{StaticResource Text.Muted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLocalSessions}" Value="False">
                    <Setter TargetName="NoSessions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Sessions" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Button.Secondary}" Margin="0"
                    VerticalAlignment="Top" Command="{Binding RefreshCommand}"/>
            <StackPanel>
                <TextBlock Text="AI usage" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Your Claude Code and Codex plans and token use, read from what each tool stores on this PC. Their sign-ins aren't used, and nothing is sent anywhere."/>
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Columns="2">
            <ContentControl Content="{Binding ClaudeCard}" Margin="0,0,8,0" Focusable="False"/>
            <ContentControl Content="{Binding CodexCard}" Margin="8,0,0,0" Focusable="False"/>
        </UniformGrid>
    </DockPanel>
</Window>
