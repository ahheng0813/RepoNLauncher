<Window x:Class="RepoNLauncher.PasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:vm="clr-namespace:RepoNLauncher.ViewModels"
        Title="Paste" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg.App}"
        FontFamily="{StaticResource Font.Mono}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>

        <!-- Its icon till there's a thumbnail; a folder's is yellow, as in the files -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="{Binding Thumbnail, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A video's thumbnail is marked as one -->
        <Style x:Key="VideoBadge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="#B0000000"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVideo}" Value="True"/>
                        <Condition Binding="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}" Value="Visible"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="{Binding Question}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding From}" Foreground="{DynamicResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <Border Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                CornerRadius="0" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <!-- One, as big as fits -->
                <ContentControl Content="{Binding Single}" Focusable="False"
                                Visibility="{Binding Single, Converter={StaticResource NullToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:PasteItem}">
                            <StackPanel>
                                <Grid Height="260">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="72"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding Size}" Foreground="{DynamicResource Text.Muted}" FontSize="12"
                                           TextAlignment="Center" Margin="0,2,0,0"
                                           Visibility="{Binding Size, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Several, a tile each -->
                <ItemsControl ItemsSource="{Binding Shown}" Focusable="False"
                              Visibility="{Binding IsSeveral, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PasteItem}">
                            <StackPanel Width="100" Margin="0,0,6,8" ToolTip="{Binding Name}">
                                <Grid Width="88" Height="88" Margin="0,2,0,6">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="40"/>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource Border.Strong}"
                                            BorderThickness="1" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="86" MaxHeight="86"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Border Style="{StaticResource VideoBadge}">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="30" Margin="2,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding More}" Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                           Visibility="{Binding More, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Total}" Foreground="{DynamicResource Text.Muted}" FontSize="12" Margin="0,8,0,0"
                   Visibility="{Binding Total, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Paste" Style="{StaticResource Button.Primary}" MinWidth="80" Margin="0" IsDefault="True"
                    Click="Paste_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
