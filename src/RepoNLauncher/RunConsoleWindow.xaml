<!-- A project's Run console in a window of its own, to keep on another screen. One per project; several projects' can be
     open at once. DataContext is the ProjectViewModel. -->
<Window x:Class="RepoNLauncher.RunConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        Title="Run - Repo'N'Launcher" Height="760" Width="1100" MinWidth="560" MinHeight="320"
        WindowStartupLocation="Manual"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  Run" Style="{StaticResource Button.Primary}"
                            Command="{Binding RunCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"/>
                    <Button Content="■  Stop" Style="{StaticResource Button.Danger}" Margin="0,0,14,0"
                            Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                    <Button x:Name="NextScreenButton" Content="&#xE7F4;" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0"
                            ToolTip="Move to the next screen" AutomationProperties.Name="Move to the next screen"
                            Click="NextScreen_Click"/>
                    <Button AutomationProperties.Name="Pin on top" Click="Pin_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="Content" Value="&#xE718;"/>
                                <Setter Property="ToolTip" Value="Pin on top of other windows"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Content" Value="&#xE840;"/>
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        <Setter Property="Background" Value="{StaticResource Accent.Muted}"/>
                                        <Setter Property="ToolTip" Value="Pinned on top — click to unpin"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Whether the app is running -->
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Text.Muted}"/>
                                <Setter Property="ToolTip" Value="Not running"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                        <Setter Property="ToolTip" Value="Running"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Branch}" Foreground="{StaticResource Text.Muted}" FontFamily="Cascadia Mono, Consolas"
                               FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>

                    <!-- Addresses the running server printed -->
                    <ItemsControl ItemsSource="{Binding DetectedUrls}" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,6,0"
                                        Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Open the site, where the Run tab's Open in says"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <controls:RunConsole x:Name="RunOutput" CanPopOut="False" Margin="14,12,14,14"/>
    </DockPanel>
</Window>
