<Window x:Class="RepoNLauncher.EmulatorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        Title="Android emulators - Repo'N'Launcher" Width="620" Height="660" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.App}"
        FontFamily="{StaticResource Font.Mono}">

    <DockPanel Margin="24,20,24,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <controls:PinOnTopButton DockPanel.Dock="Right" Margin="2,0,0,0"/>
            <TextBlock Text="Android emulators" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- The same as Settings > Emulators -->
        <controls:EmulatorsPanel/>
    </DockPanel>
</Window>
