<Window x:Class="RepoNLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        xmlns:vm="clr-namespace:RepoNLauncher.ViewModels"
        Title="Repo'N'Launcher" Height="820" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:ProjectKindToBrushConverter x:Key="KindToBrush"/>
        <conv:StringStartsWithConverter x:Key="StartsWith"/>
        <conv:FileChangeTypeToBrushConverter x:Key="ChangeTypeToBrush"/>
        <conv:FileChangeTypeToLetterConverter x:Key="ChangeTypeToLetter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Project list row: checkbox, kind badge, name/branch/status, indicators, accent selection stripe.
             The highlight follows ProjectViewModel.IsSelected rather than the tree's own selection. -->
        <Style x:Key="ProjectTreeItem" TargetType="TreeViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid Margin="0,2" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Stripe" Grid.Column="0" Background="{StaticResource Accent}"
                                    CornerRadius="2" Opacity="0"/>
                            <Border x:Name="Bd" Grid.Column="1" Background="Transparent"
                                    CornerRadius="7" Margin="4,0,0,0">
                                <ContentPresenter ContentSource="Header" Margin="8,9"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                                <Setter TargetName="Stripe" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder section: a header that opens/closes it, then its repos and subsections indented along a guide line.
             Sections aren't focusable, so clicking one only toggles it and arrow keys move between projects. -->
        <Style x:Key="GroupTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <ToggleButton Focusable="False" Cursor="Hand" Margin="7,4,0,2" Foreground="{StaticResource Text.Primary}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="6,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                            </ToggleButton>
                            <Grid x:Name="ItemsHost">
                                <Border Width="1" HorizontalAlignment="Left" Margin="19,0,0,4" Background="{StaticResource Border.Subtle}"/>
                                <ItemsPresenter Margin="14,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <controls:ProjectTreeItemStyleSelector x:Key="ProjectTreeItemStyle"
                                               GroupStyle="{StaticResource GroupTreeItem}"
                                               ProjectStyle="{StaticResource ProjectTreeItem}"/>

        <Style x:Key="KindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource KindToBrush}}"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
        </Style>

        <Style x:Key="ConsoleLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C7CCD6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource StartsWith}, ConverterParameter='[dashboard]'}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiffLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource StartsWith}, ConverterParameter='+'}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource StartsWith}, ConverterParameter='-'}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource StartsWith}, ConverterParameter='@@'}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One tool in the AI usage bar: tile, name, plan, then the session and week limits as small meters -->
        <DataTemplate x:Key="UsageBarTool" DataType="{x:Type vm:AiToolCardViewModel}">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Tile" Width="18" Height="18" CornerRadius="5" Background="{StaticResource Accent}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Letter}" FontSize="10.5" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Plan}" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding BarLimits}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel x:Name="Limit" Orientation="Horizontal" Margin="14,0,0,0" Background="Transparent"
                                        ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding ShortLabel}" Foreground="{StaticResource Text.Secondary}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Grid Width="64" Height="5" Margin="8,1,8,0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource Bg.Hover}" CornerRadius="2.5"/>
                                    <Border x:Name="Fill" Background="{StaticResource Accent}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Fraction}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="High">
                                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Full">
                                    <Setter TargetName="Fill" Property="Background" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                    <Setter TargetName="Limit" Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding BarNote}" Foreground="{StaticResource Text.Muted}" FontSize="12" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding BarNote, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="Claude">
                    <Setter TargetName="Tile" Property="Background" Value="#C96442"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Codex">
                    <Setter TargetName="Tile" Property="Background" Value="#3B3F4A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ChangeTypeBadge" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{Binding Type, Converter={StaticResource ChangeTypeToBrush}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Fill="{StaticResource Accent.Gradient}"/>
                <DockPanel Grid.Row="1" Margin="20,14">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Accent.Gradient}" Margin="0,0,10,0">
                            <TextBlock Text="R" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Repo'N'Launcher" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="Fetch All" Style="{StaticResource Button.Primary}" Command="{Binding FetchAllCommand}"/>
                        <Button Content="Fetch Selected" Style="{StaticResource Button.Secondary}" Command="{Binding FetchSelectedCommand}"/>
                        <Border Width="1" Background="{StaticResource Border.Subtle}" Margin="4,2,12,2"/>
                        <Button Content="Add Project" Style="{StaticResource Button.Secondary}" Command="{Binding AddProjectFolderCommand}"/>
                        <Button Content="Scan Folder" Style="{StaticResource Button.Secondary}" Command="{Binding ScanFolderCommand}"/>
                        <Button Content="Rescan All" Style="{StaticResource Button.Secondary}" Command="{Binding RescanAllFoldersCommand}"/>
                        <Button Content="Repos on this PC" Style="{StaticResource Button.Secondary}" Click="OpenPcRepos_Click"
                                ToolTip="Find every repo on this PC and see which are yours on GitHub (needs GitHub sign-in)"/>
                        <Button Content="Clone from GitHub" Style="{StaticResource Button.Secondary}" Click="OpenCloneRepos_Click"
                                ToolTip="List your GitHub repos, see which this PC has, and clone the others (needs GitHub sign-in)"/>
                        <Border Width="1" Background="{StaticResource Border.Subtle}" Margin="4,2,12,2"/>
                        <Button Content="AI Chat" Style="{StaticResource Button.Secondary}" Click="OpenAiChat_Click"
                                ToolTip="Chat with Claude Code or Codex in a project, and read your saved chats"/>
                        <Button Style="{StaticResource Button.Secondary}" Margin="0" ToolTip="Show or hide the phone screen panel"
                                Command="{Binding PhoneScreen.TogglePanelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Phone Screen"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{StaticResource Border.Subtle}" Margin="12,2,12,2"/>
                        <!-- GitHub account: only Repos on this PC, Clone from GitHub and creating pull requests need it -->
                        <Button Style="{StaticResource Button.Secondary}" Margin="0" Click="SignInToGitHub_Click"
                                Visibility="{Binding GitHub.Login, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sign in with GitHub"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource Bg.PanelAlt}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                                CornerRadius="7" Padding="10,0,3,0"
                                Visibility="{Binding GitHub.Login, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding GitHub.Login}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           ToolTip="Signed in to GitHub"/>
                                <Button Content="&#xF3B1;" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0" ToolTip="Sign out of GitHub"
                                        AutomationProperties.Name="Sign out of GitHub"
                                        Command="{Binding GitHub.SignOutCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- AI usage, always in view; View details opens the window with token use and the rest -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,6"
                        DataContext="{Binding AiUsage}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="0" Padding="10,4"
                                Click="OpenAiUsage_Click" AutomationProperties.Name="View usage details"
                                ToolTip="Plan limits, token use and models for Claude Code and Codex">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View details" FontSize="12"/>
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="7,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <!-- Reads the usage again and asks for the plan limits now; the arrow turns while any refresh runs -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0" Padding="8,4"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh usage"
                                ToolTip="Refresh usage and check the plan limits now">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Spin">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Spin"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="AI USAGE" Style="{StaticResource SectionLabel}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Reading usage…" Foreground="{StaticResource Text.Muted}" FontSize="12"
                                       Visibility="{Binding ClaudeCard, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                            <ContentControl Content="{Binding ClaudeCard}" ContentTemplate="{StaticResource UsageBarTool}" Focusable="False"
                                            Margin="0,0,30,0"/>
                            <ContentControl Content="{Binding CodexCard}" ContentTemplate="{StaticResource UsageBarTool}" Focusable="False"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*" MinWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300">
                    <!-- The splitter sets Width locally, so hiding the panel clamps it with MaxWidth instead;
                         showing it again restores whatever width the user dragged it to. -->
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="MinWidth" Value="240"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PhoneScreen.IsPanelVisible}" Value="False">
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MaxWidth" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- Project list: scanned folders as collapsible sections, nested where a subfolder holds several repos -->
            <Border Grid.Column="0" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Padding="8">
                <TreeView ItemsSource="{Binding ProjectTree}" Background="Transparent" BorderThickness="0" Padding="0"
                          ItemContainerStyleSelector="{StaticResource ProjectTreeItemStyle}"
                          SelectedItemChanged="ProjectTree_SelectedItemChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:ProjectGroupViewModel}" ItemsSource="{Binding Children}"
                                                  ItemContainerStyleSelector="{StaticResource ProjectTreeItemStyle}">
                            <DockPanel ToolTip="{Binding Path}">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Bg.PanelAlt}" CornerRadius="8" Padding="7,1"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding RepoCount}" FontSize="10.5" Foreground="{StaticResource Text.Secondary}"/>
                                </Border>
                                <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Width="12"
                                           Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <!-- Lines up with the repo checkboxes one level in; a click here ticks, not toggles, the section -->
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="Tick every repo in this section for Fetch Selected"/>
                                <TextBlock x:Name="FolderIcon" Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;"/>
                                    <Setter TargetName="FolderIcon" Property="Text" Value="&#xF12B;"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type vm:ProjectViewModel}">
                            <Grid ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,10,0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,8,0"/>
                                        <Border Style="{StaticResource KindBadge}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Branch}" FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="{StaticResource Cyan}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" Margin="0,4,6,0"
                                             ToolTip="Uncommitted changes"
                                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" Margin="0,4,6,0"
                                             ToolTip="Running"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="✕" ToolTip="Remove from dashboard" Style="{StaticResource Button.Icon}"
                                            Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="1" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedProject, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="Select or add a project to get started." Foreground="{StaticResource Text.Muted}" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid Visibility="{Binding SelectedProject, Converter={StaticResource NullToVisibility}}">
                    <TabControl x:Name="ProjectTabControl" DataContext="{Binding SelectedProject}">

                        <!-- Overview -->
                        <TabItem Header="Overview">
                            <StackPanel Margin="4,0">
                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Path}" Foreground="{StaticResource Text.Muted}" FontFamily="Consolas"
                                           FontSize="11.5" Margin="0,4,0,18" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="KIND" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center" Margin="0,0,10,10"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <ComboBox Width="140" Height="30" ItemsSource="{x:Static vm:ProjectViewModel.AllKinds}"
                                                  SelectedItem="{Binding Kind, Mode=TwoWay}"
                                                  ToolTip="Change this if the project type was detected wrong"/>
                                        <TextBlock Text="{Binding DetectedKindNote}" Foreground="{StaticResource Text.Muted}" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <!-- The branch checked out now -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BRANCH" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center" Margin="0,0,10,10"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="{StaticResource Accent.Muted}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center"
                                                ToolTip="The branch checked out now">
                                            <TextBlock Text="{Binding Branch}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="13"/>
                                        </Border>
                                        <TextBlock Text="current" Foreground="{StaticResource Text.Muted}" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Visibility="{Binding IsPublished, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}ahead {0} · behind {1}">
                                                    <Binding Path="Ahead"/>
                                                    <Binding Path="Behind"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <!-- A branch made here that the remote doesn't have yet -->
                                        <TextBlock Text="{Binding NotPublishedText}" Foreground="{StaticResource Warning}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="16,0,10,0"
                                                   Visibility="{Binding NeedsPublish, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Style="{StaticResource Button.Primary}" Margin="0" Padding="12,5"
                                                Command="{Binding PublishBranchCommand}" AutomationProperties.Name="Publish branch"
                                                Visibility="{Binding NeedsPublish, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Push this branch to the remote, and pull from and push to it from now on">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Publish branch" Foreground="White" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Picking only chooses; Switch does it. One only the remote has gets a local copy first. -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SWITCH TO" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center" Margin="0,0,10,10"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <ComboBox Width="260" Height="30" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                                                  AutomationProperties.Name="Switch to branch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas"/>
                                                        <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource Text.Muted}" FontSize="11"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Switch" Style="{StaticResource Button.Primary}" Margin="8,0,8,0"
                                                Command="{Binding SwitchBranchCommand}"
                                                ToolTip="Switch to the picked branch. Uncommitted changes come along when they don't clash."/>
                                        <Button Content="New branch…" Style="{StaticResource Button.Secondary}" Margin="0"
                                                Click="NewBranch_Click" ToolTip="Make a new branch, from this one or another"/>
                                    </StackPanel>
                                    <!-- The default is saved per branch and used by Fetch Latest; Merge now merges the pick just once -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="MERGE FROM" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Top" Margin="0,2,10,10"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                            <Run Text="Default:" Foreground="{StaticResource Text.Secondary}"/>
                                            <Run Text="{Binding DefaultMergeName, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                            <Run Text="·" Foreground="{StaticResource Text.Muted}"/>
                                            <Run Text="{Binding MergeFromHint, Mode=OneWay}" Foreground="{StaticResource Text.Muted}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="260" Height="30" ItemsSource="{Binding MergeSources}"
                                                      SelectedItem="{Binding SelectedMergeSource}" AutomationProperties.Name="Merge from"/>
                                            <Button Content="Update default" Style="{StaticResource Button.Secondary}" Margin="8,0,8,0"
                                                    Command="{Binding UpdateMergeDefaultCommand}"
                                                    ToolTip="Make Fetch Latest merge the picked branch into this one from now on"/>
                                            <Button Content="Merge now" Style="{StaticResource Button.Secondary}" Margin="0"
                                                    Command="{Binding MergeNowCommand}"
                                                    ToolTip="Merge the picked branch into this one just this once; the default stays as it is"/>
                                        </StackPanel>
                                        <TextBlock Foreground="{StaticResource Warning}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Not saved. Update default to have Fetch Latest use it every time, or Merge now to merge it just once."
                                                   Visibility="{Binding IsMergePickUnsaved, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="STATUS" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource Cyan}"
                                               Margin="0,0,0,10" TextWrapping="Wrap"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Fetch Latest" Style="{StaticResource Button.Primary}" Command="{Binding FetchLatestCommand}"/>
                                    <Button Style="{StaticResource Button.Secondary}" Click="CreatePullRequest_Click"
                                            AutomationProperties.Name="Create Pull Request"
                                            ToolTip="Open a pull request on GitHub from this branch">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="13" Height="13"
                                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Create Pull Request"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Refresh Status" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshStatusCommand}"/>
                                    <Button Content="Remove from Dashboard" Style="{StaticResource Button.Danger}"
                                            Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <ProgressBar Width="80" IsIndeterminate="True" VerticalAlignment="Center" Margin="10,0,0,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <!-- Built-in apps, then the user's own (shared by all projects), then the button to edit that list -->
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="OPEN IN" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Top" Margin="0,9,12,0"/>
                                    <WrapPanel>
                                        <WrapPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                            </Style>
                                        </WrapPanel.Resources>
                                        <Button Content="Explorer" Command="{Binding OpenInExplorerCommand}"/>
                                        <Button Content="Visual Studio" Command="{Binding OpenInVisualStudioCommand}"
                                                ToolTip="Opens the solution, or the folder if there is none"/>
                                        <Button Content="Android Studio" Command="{Binding OpenInAndroidStudioCommand}"/>
                                        <Button Content="VS Code" Command="{Binding OpenInVsCodeCommand}"/>
                                        <Button Command="{Binding OpenInGitHubCommand}" AutomationProperties.Name="GitHub"
                                                ToolTip="{Binding GitHubToolTip}" ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="13" Height="13"
                                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="GitHub"/>
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding DataContext.OpenWithApps, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}" ToolTip="{Binding Program}"
                                                            Command="{Binding DataContext.OpenInAppCommand, ElementName=ProjectTabControl}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add app" Click="EditOpenWithApps_Click"
                                                ToolTip="Add, edit or remove the apps in this list (shared by all projects)"/>
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- Changes -->
                        <TabItem Header="Changes">
                            <DockPanel Margin="4,0">
                                <Border DockPanel.Dock="Top" Background="{StaticResource Danger.Muted}" BorderBrush="{StaticResource Danger}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                                        Visibility="{Binding HasMergeConflict, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Continue Merge" Style="{StaticResource Button.Primary}" Command="{Binding CommitMergeCommand}"/>
                                            <Button Content="Abort Merge" Style="{StaticResource Button.Danger}" Command="{Binding AbortMergeCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="⚠ Merge in progress — resolve the conflicted file(s) below, then continue or abort."
                                                   Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    </DockPanel>
                                </Border>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding LoadChangesCommand}"/>
                                    <Button Content="Discard All" Style="{StaticResource Button.Danger}" Command="{Binding DiscardAllCommand}"/>
                                    <Border Width="1" Background="{StaticResource Border.Subtle}" Margin="4,4,12,4"/>
                                    <TextBlock Text="Stash message" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="220" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                             Text="{Binding StashMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Stash Changes" Style="{StaticResource Button.Secondary}" Command="{Binding StashCommand}"/>
                                </StackPanel>

                                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10,8" Background="{StaticResource Bg.PanelAlt}"
                                        CornerRadius="8" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"
                                                   Text="{Binding Stashes.Count, StringFormat='STASHES ({0})'}"/>
                                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Stashes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Bg.Hover}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text.Secondary}"
                                                                       MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                            <Button Content="Apply" Style="{StaticResource Button.Icon}" Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.StashApplyCommand, ElementName=ProjectTabControl}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Drop" Style="{StaticResource Button.Icon}"
                                                                    Command="{Binding DataContext.StashDropCommand, ElementName=ProjectTabControl}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" Background="{StaticResource Bg.PanelAlt}"
                                            CornerRadius="8" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="COMMIT MESSAGE" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Content="Commit All Changes" Style="{StaticResource Button.Primary}"
                                                    Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding CommitCommand}"/>
                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Cyan}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource Bg.PanelAlt}" CornerRadius="8"
                                            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                      <Grid>
                                        <TextBlock Text="Working tree clean — no changes." Foreground="{StaticResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding IsWorkingTreeClean, Converter={StaticResource BoolToVisibility}}"/>
                                        <ListBox ItemsSource="{Binding ChangedFiles}" SelectedItem="{Binding SelectedChangedFile}"
                                                 BorderThickness="0" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource ChangeTypeBadge}" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Type, Converter={StaticResource ChangeTypeToLetter}}"
                                                                       FontSize="10" FontWeight="Bold" Foreground="#0D0F14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" FontSize="12"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource Button.Icon}"
                                                                ToolTip="Discard this file's changes"
                                                                Command="{Binding DataContext.DiscardFileCommand, ElementName=ProjectTabControl}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                      </Grid>
                                    </Border>
                                    </DockPanel>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"
                                                    Visibility="{Binding IsSelectedFileConflicted, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="CONFLICT" Foreground="{StaticResource Danger}" FontWeight="Bold" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="Use Ours" Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding ResolveOursCommand}" CommandParameter="{Binding SelectedChangedFile}"/>
                                            <Button Content="Use Theirs" Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding ResolveTheirsCommand}" CommandParameter="{Binding SelectedChangedFile}"/>
                                            <Button Content="Open in Editor" Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding OpenFileInEditorCommand}" CommandParameter="{Binding SelectedChangedFile}"/>
                                            <Button Content="Mark Resolved" Style="{StaticResource Button.Primary}"
                                                    Command="{Binding MarkResolvedCommand}" CommandParameter="{Binding SelectedChangedFile}"/>
                                        </StackPanel>

                                        <Border Grid.Row="1" Background="{StaticResource Bg.Console}" CornerRadius="8"
                                                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                          <Grid>
                                            <TextBlock Text="Select a file to view its changes." Foreground="{StaticResource Text.Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="{Binding SelectedChangedFile, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                                            <ListBox ItemsSource="{Binding DiffLines}" Background="Transparent" Padding="10" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     VirtualizingPanel.ScrollUnit="Pixel">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource DiffLine}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                          </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </TabItem>

                        <!-- Commits -->
                        <TabItem Header="Commits">
                            <DockPanel Margin="4,0">
                                <Button DockPanel.Dock="Top" Content="Refresh Commits" Style="{StaticResource Button.Secondary}"
                                        HorizontalAlignment="Left" Margin="0,0,0,12" Command="{Binding LoadCommitsCommand}"/>
                                <ListView ItemsSource="{Binding Commits}" BorderThickness="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Hash" Width="80" DisplayMemberBinding="{Binding ShortHash}"/>
                                            <GridViewColumn Header="Author" Width="140" DisplayMemberBinding="{Binding Author}"/>
                                            <GridViewColumn Header="Date" Width="170" DisplayMemberBinding="{Binding Date}"/>
                                            <GridViewColumn Header="Message" Width="420" DisplayMemberBinding="{Binding Message}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </TabItem>

                        <!-- Run -->
                        <TabItem Header="Run">
                            <DockPanel Margin="4,0">
                                <!-- Saved per project as it's typed; empty falls back to the kind's own command (see the placeholder) -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left" Text="START COMMAND" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button DockPanel.Dock="Right" Content="Choose file…" Style="{StaticResource Button.Secondary}"
                                            Margin="8,0,0,0" Command="{Binding ChooseStartFileCommand}"
                                            ToolTip="Pick the script that starts this project; the command to run it is filled in"
                                            Visibility="{Binding CanChooseStartFile, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource Button.Secondary}"
                                            Margin="8,0,0,0" Command="{Binding SaveStartCommandCommand}"
                                            AutomationProperties.Name="Save command"
                                            ToolTip="Keep this command in the list below, to run it with one click"/>
                                    <Grid>
                                        <TextBox x:Name="StartCommandBox" FontFamily="Cascadia Mono, Consolas"
                                                 Text="{Binding StartCommand, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding StartCommandHint}" Foreground="{StaticResource Text.Muted}" FontSize="12.5"
                                                   VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=StartCommandBox, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=Invert}"/>
                                    </Grid>
                                </DockPanel>

                                <!-- Saved start commands, each run with one click; hidden until one is saved -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SavedCommands.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock DockPanel.Dock="Left" Text="SAVED" Style="{StaticResource SectionLabel}"
                                               VerticalAlignment="Top" Margin="0,9,12,0"/>
                                    <ItemsControl ItemsSource="{Binding SavedCommands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                                    <Button Style="{StaticResource Button.Secondary}" Margin="0"
                                                            Command="{Binding DataContext.RunSavedCommand, ElementName=ProjectTabControl}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding StringFormat=Run {0}}"
                                                            ToolTip="{Binding StringFormat=Run {0}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Content="✕" Style="{StaticResource Button.Icon}" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.RemoveSavedCommandCommand, ElementName=ProjectTabControl}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding StringFormat=Remove {0}}"
                                                            ToolTip="Remove from the saved commands"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Flutter}">
                                        <ComboBox Width="240" Height="32" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,8,0"/>
                                        <Button Content="Refresh Devices" Style="{StaticResource Button.Secondary}" Command="{Binding LoadDevicesCommand}"/>
                                        <Button Content="Emulators…" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                ToolTip="Start an Android emulator to run on, or create one" Click="OpenEmulators_Click"/>
                                    </StackPanel>

                                    <!-- Addresses the running server printed (dotnet, or any dev server's localhost URL) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectedUrls.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="URL" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ItemsControl ItemsSource="{Binding DetectedUrls}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.OpenUrlCommand, ElementName=ProjectTabControl}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button Content="▶  Run" Style="{StaticResource Button.Primary}" Margin="16,0,8,0"
                                            Command="{Binding RunCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolean}}"/>
                                    <Button Content="■  Stop" Style="{StaticResource Button.Danger}"
                                            Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                                </StackPanel>

                                <!-- The running app's input, as if typed in its terminal: answers to its prompts, flutter run's keys -->
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Send" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                Command="{Binding SendInputCommand}"
                                                ToolTip="Send the line to the app, as if typed in its terminal and Enter pressed"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Flutter}">
                                            <Button Content="Hot reload" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                    Command="{Binding SendKeyCommand}" CommandParameter="r"
                                                    ToolTip="Sends r to flutter run: loads your code changes and keeps the app's state"/>
                                            <Button Content="Hot restart" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                    Command="{Binding SendKeyCommand}" CommandParameter="R"
                                                    ToolTip="Sends R to flutter run: loads your code changes and restarts the app"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <TextBox x:Name="ConsoleInputBox" FontFamily="Cascadia Mono, Consolas"
                                                 Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsRunning}" AutomationProperties.Name="Input for the app">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SendInputCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="{Binding ConsoleInputHint}" Foreground="{StaticResource Text.Muted}" FontSize="12.5"
                                                   VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=ConsoleInputBox, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=Invert}"/>
                                    </Grid>
                                </DockPanel>

                                <Border Background="{StaticResource Bg.Console}" CornerRadius="8" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                    <ListBox ItemsSource="{Binding ConsoleOutput}" Background="Transparent" Padding="10"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.ScrollChanged="Console_ScrollChanged" AutomationProperties.Name="Console output">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource ConsoleLine}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0,1"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </DockPanel>
                        </TabItem>

                        <!-- Environment -->
                        <TabItem Header="Environment">
                            <DockPanel Margin="4,0">
                                <Button DockPanel.Dock="Top" Content="Refresh Environment" Style="{StaticResource Button.Secondary}"
                                        HorizontalAlignment="Left" Margin="0,0,0,12" Command="{Binding LoadEnvironmentCommand}"/>
                                <ListView ItemsSource="{Binding EnvEntries}" BorderThickness="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Source" Width="220" DisplayMemberBinding="{Binding Source}"/>
                                            <GridViewColumn Header="Key" Width="220" DisplayMemberBinding="{Binding Key}"/>
                                            <GridViewColumn Header="Value" Width="340" DisplayMemberBinding="{Binding Value}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="12" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False"
                          Visibility="{Binding PhoneScreen.IsPanelVisible, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Phone screen: an Android device mirrored by scrcpy, independent of the selected project -->
            <Border Grid.Column="3" DataContext="{Binding PhoneScreen}" Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10" Padding="12"
                    Visibility="{Binding IsPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="&#xE8EA;" ToolTip="Android emulators: start one, or create one" Style="{StaticResource Button.Ghost}"
                                    AutomationProperties.Name="Android emulators" Click="OpenEmulators_Click"/>
                            <Button Command="{Binding ToggleAudioCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                        <Setter Property="Content" Value="&#xE767;"/>
                                        <Setter Property="ToolTip" Value="Phone sound plays on this PC — click to keep it on the phone"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAudioEnabled}" Value="False">
                                                <Setter Property="Content" Value="&#xE74F;"/>
                                                <Setter Property="ToolTip" Value="Phone sound stays on the phone — click to play it on this PC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="&#xE740;" ToolTip="Full screen" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ToggleFullScreenCommand}"/>
                            <Button Command="{Binding TogglePopOutCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                        <Setter Property="Content" Value="&#xE8A7;"/>
                                        <Setter Property="ToolTip" Value="Pop out into its own window"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPoppedOut}" Value="True">
                                                <Setter Property="Content" Value="&#xE73F;"/>
                                                <Setter Property="ToolTip" Value="Dock back into the dashboard"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="&#xE711;" ToolTip="Hide panel (the Phone Screen button in the header brings it back)"
                                    Style="{StaticResource Button.Ghost}" Command="{Binding TogglePanelCommand}"/>
                        </StackPanel>
                        <TextBlock Text="PHONE SCREEN" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Height="32" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                  DropDownOpened="DeviceCombo_DropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Model, Mode=OneWay}"/>
                                        <Run Text="{Binding Serial, Mode=OneWay}" Foreground="{StaticResource Text.Muted}" FontSize="11"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="&#xE72C;" ToolTip="Refresh devices" Style="{StaticResource Button.Ghost}"
                                Margin="4,0" Command="{Binding RefreshDevicesCommand}"/>
                        <Button Grid.Column="2" Content="▶  Show" Margin="0" Command="{Binding ShowCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirroring}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="■  Stop" Style="{StaticResource Button.Danger}" Margin="0"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsMirroring, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource Text.Secondary}"
                               FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,8,0,0"/>

                    <!-- Padding keeps the square scrcpy window inside the rounded corners, like a bezel -->
                    <Border Background="Black" CornerRadius="8" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" Padding="3">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="12"
                                        Visibility="{Binding ShowInstallPrompt, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Mirroring needs scrcpy" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,0,0,14"
                                           Text="A free, open-source tool that streams an Android phone's screen and sound to this PC. One-time download (about 11 MB) from github.com/Genymobile/scrcpy."/>
                                <Button Content="Install scrcpy" Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" Margin="0"
                                        Command="{Binding InstallScrcpyCommand}"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center" Margin="12"
                                        Visibility="{Binding ShowPoppedOutNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Showing in a separate window" Foreground="{StaticResource Text.Secondary}"
                                           HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <Button Content="Dock back here" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Center" Margin="0"
                                        Command="{Binding TogglePopOutCommand}"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center" Margin="12"
                                        Visibility="{Binding ShowIdleNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Pick a device and press Show. Running a Flutter app on an Android device shows its screen here automatically."/>
                            </StackPanel>

                            <controls:ScreenHost ScreenHandle="{Binding DockedScreenHandle}"
                                                 Visibility="{Binding HasDockedScreen, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,1,0,0" Padding="20,8">
            <DockPanel>
                <!-- Version and updates: the installed app downloads a newer release in the background, then offers a restart -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" DataContext="{Binding Updates}" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                    <Button Content="Check for updates" Style="{StaticResource Button.Secondary}" FontSize="11.5" Padding="8,2" Margin="10,0,0,0"
                            Command="{Binding CheckCommand}"
                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Restart to update" Style="{StaticResource Button.Primary}" FontSize="11.5" Padding="10,2" Margin="10,0,0,0"
                            Command="{Binding RestartCommand}"
                            Visibility="{Binding ReadyVersion, Converter={StaticResource NullToVisibility}}"/>
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Text.Secondary}" FontSize="11.5" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="App version"/>
                </StackPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="110"
                             Visibility="{Binding IsFetchingAll, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding GlobalStatus}" Foreground="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
