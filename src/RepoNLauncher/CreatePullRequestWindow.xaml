<Window x:Class="RepoNLauncher.CreatePullRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        Title="Create pull request - Repo'N'Launcher" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.App}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="22" Height="22" Stretch="Uniform"
                  VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Create pull request" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding RepoText}" Foreground="{StaticResource Text.Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   Margin="0,6,0,18"/>

        <!-- A branch here or on GitHub (the current one at first), into one GitHub has -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="FROM" Style="{StaticResource FieldLabel}"/>
                <ComboBox Height="32" ItemsSource="{Binding HeadBranches}" SelectedItem="{Binding HeadBranch}"
                          AutomationProperties.Name="From branch"
                          ToolTip="The branch with the changes: the current one, another one on this PC, or one only GitHub has">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas"/>
                                <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource Text.Muted}" FontSize="11"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Text.Muted}"
                       VerticalAlignment="Bottom" Margin="14,0,14,9"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="INTO" Style="{StaticResource FieldLabel}"/>
                <ComboBox Height="32" ItemsSource="{Binding BaseBranches}" SelectedItem="{Binding BaseBranch}"
                          AutomationProperties.Name="Into branch" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding CommitsText}" Style="{StaticResource Note}" Margin="0,8,0,0"
                   Visibility="{Binding CommitsText, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <!-- GitHub allows one open pull request per branch -->
        <Border Background="{StaticResource Bg.PanelAlt}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                Visibility="{Binding Existing, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" Command="{Binding OpenExistingCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open it"/>
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="7,1,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5">
                    <Run Text="{Binding Existing.Number, Mode=OneWay, StringFormat='Pull request #{0} is already open from this branch:'}"/>
                    <Run Text="{Binding Existing.Title, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <TextBlock Text="TITLE" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title"/>

        <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description"
                 Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

        <CheckBox Content="Create as a draft" IsChecked="{Binding IsDraft}" Margin="0,12,0,0"
                  ToolTip="A draft can't be merged until it's marked ready for review"/>

        <StackPanel Margin="0,14,0,0">
            <TextBlock Text="{Binding PushNote}" Style="{StaticResource Note}"
                       Visibility="{Binding PushNote, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            <TextBlock Text="{Binding SignInNote}" Style="{StaticResource Note}" Margin="0,4,0,0"
                       Visibility="{Binding SignInNote, Converter={StaticResource StringNotEmptyToVisibility}}"/>
        </StackPanel>

        <DockPanel Margin="0,14,0,0" Visibility="{Binding BusyText, Converter={StaticResource StringNotEmptyToVisibility}}">
            <ProgressBar DockPanel.Dock="Left" Width="60" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="12.5" Margin="0,14,0,0"
                   Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Margin="0" Command="{Binding OpenOnGitHubCommand}"
                    ToolTip="Open GitHub's new pull request page in the browser, filled in with the above">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Finish on GitHub"/>
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="7,1,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" IsCancel="True"/>
                <Button Content="Create pull request" Style="{StaticResource Button.Primary}" Margin="0" IsDefault="True"
                        Command="{Binding CreateCommand}"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
