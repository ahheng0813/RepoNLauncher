<!-- A project's Run console in a window of its own, to keep on another screen. One per project; several projects' can be
     open at once. DataContext is the ProjectViewModel. -->
<Window x:Class="RepoNLauncher.RunConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        xmlns:services="clr-namespace:RepoNLauncher.Services"
        Title="Run - Repo'N'Launcher" Height="760" Width="1100" MinWidth="560" MinHeight="320"
        WindowStartupLocation="Manual"
        Background="{StaticResource Bg.App}"
        FontFamily="{StaticResource Font.Mono}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Elevated}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  Run" Style="{StaticResource Button.Primary}"
                            Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"/>
                    <Button Content="■  Stop" Style="{StaticResource Button.Danger}"
                            Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                    <Button Content="↻  Restart" Style="{StaticResource Button.Secondary}" Margin="0,0,14,0"
                            Command="{Binding RestartCommand}"
                            ToolTip="Stops the app whose console shows and runs it again: the same command, on the same device"/>
                    <Button x:Name="NextScreenButton" Content="&#xE7F4;" Style="{StaticResource Button.Ghost}" Margin="0,0,2,0"
                            ToolTip="Move to the next screen" AutomationProperties.Name="Move to the next screen"
                            Click="NextScreen_Click"/>
                    <controls:PinOnTopButton/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Whether the app is running -->
                    <Rectangle Width="8" Height="8" VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource Text.Muted}"/>
                                <Setter Property="ToolTip" Value="Not running"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                        <Setter Property="ToolTip" Value="Running"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Branch}" Foreground="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}"
                               FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>

                    <!-- Addresses the running server printed -->
                    <ItemsControl ItemsSource="{Binding DetectedUrls}" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,6,0"
                                        Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Open the site, where the Run tab's Open in says. Right-click to open it in the dashboard browser or your default browser instead.">
                                        <Button.ContextMenu>
                                            <!-- Just this once, whatever Open in says -->
                                            <ContextMenu>
                                                <MenuItem Header="Open in the dashboard browser"
                                                          Command="{Binding PlacementTarget.Tag.OpenSiteInDashboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="{x:Static services:DefaultBrowser.OpenLabel}"
                                                          Command="{Binding PlacementTarget.Tag.OpenSiteInDefaultBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <controls:RunConsole x:Name="RunOutput" CanPopOut="False" Margin="14,12,14,14"/>
    </DockPanel>
</Window>
