<Window x:Class="RepoNLauncher.PhoneScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        Title="Phone Screen - Repo'N'Launcher" Height="860" Width="420"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsPinnedOnTop}"
        Background="{DynamicResource Bg.Console}"
        FontFamily="{StaticResource Font.Mono}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- In full screen the toolbar hides; touching the top edge of the screen (this strip) brings it back -->
        <Border x:Name="RevealStrip" Grid.Row="0" Height="4" Background="Transparent" Visibility="Collapsed"
                MouseEnter="RevealStrip_MouseEnter"/>

        <Border x:Name="Toolbar" Grid.Row="0" Background="{DynamicResource Bg.Elevated}" BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,0,0,1" Padding="10,6" MouseLeave="Toolbar_MouseLeave">
            <DockPanel>
                <controls:DeviceTools x:Name="Tools" DockPanel.Dock="Bottom" Margin="-6,4,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding TogglePinnedOnTopCommand}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="Content" Value="&#xE718;"/>
                                <Setter Property="ToolTip" Value="Pin on top of other windows"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinnedOnTop}" Value="True">
                                        <Setter Property="Content" Value="&#xE840;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        <Setter Property="Background" Value="{DynamicResource Accent.Muted}"/>
                                        <Setter Property="ToolTip" Value="Pinned on top — click to unpin"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ToggleFullScreenCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Setter Property="Content" Value="Full screen (F11)"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                        <Setter Property="Content" Value="Exit full screen (Esc)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Dock back" Style="{StaticResource Button.Secondary}" Margin="0"
                            ToolTip="Put the screen back in the dashboard's side panel" Command="{Binding TogglePopOutCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <!-- Only visible while there's no screen: the host's native window covers it otherwise -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text.Secondary}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="▶  Show" HorizontalAlignment="Center" Margin="0,14,0,0" Command="{Binding ShowCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMirroring}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <controls:ScreenHost x:Name="Screen" Grid.Row="1" ScreenHandle="{Binding PopOutScreenHandle}"
                             Visibility="{Binding HasScreen, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</Window>
