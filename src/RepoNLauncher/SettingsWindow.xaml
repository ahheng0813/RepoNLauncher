<Window x:Class="RepoNLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RepoNLauncher.Controls"
        xmlns:conv="clr-namespace:RepoNLauncher.Converters"
        Title="Settings - Repo'N'Launcher" Width="720" Height="720" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.App}"
        FontFamily="{StaticResource Font.Mono}">

    <Window.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- A block of settings: boxed like the dashboard's panels -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="TextLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" TextTrimming="CharacterEllipsis"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A format in the Date and Time lists: how the sample looks, then what it is -->
        <DataTemplate x:Key="FormatChoiceTemplate">
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Example, Mode=OneWay}"/>
                <Run Text="  "/>
                <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource Text.Muted}" FontSize="11"/>
            </TextBlock>
        </DataTemplate>

        <!-- An About row: label on the left, value on the right -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,16,5"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,18,20,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <controls:PinOnTopButton DockPanel.Dock="Right"/>
            <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource Button.Secondary}" Margin="0,14,0,0"
                HorizontalAlignment="Right" MinWidth="80" IsCancel="True" Click="Close_Click"/>

        <TabControl x:Name="Tabs">
            <!-- Date & time: applied to the dashboard as it changes -->
            <TabItem Header="Date &amp; time">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding Preview}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                           TextWrapping="Wrap" AutomationProperties.Name="Preview of the date and time format"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="Used for commit dates in Commits, file dates in the phone's Files, and times such as when updates and AI usage were last checked. Dates are shown in this PC's time zone."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="DATE" Style="{StaticResource SectionLabel}"/>
                                <ComboBox Height="32" ItemsSource="{Binding DateChoices}" SelectedItem="{Binding DateChoice}"
                                          ItemTemplate="{StaticResource FormatChoiceTemplate}" AutomationProperties.Name="Date format"/>
                                <StackPanel Visibility="{Binding IsCustomDate, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding CustomDatePattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                                             AutomationProperties.Name="Custom date pattern"/>
                                    <TextBlock Text="{Binding DateError}" Style="{StaticResource Error}"
                                               Visibility="{Binding DateError, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                </StackPanel>

                                <TextBlock Text="TIME" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                                <ComboBox Height="32" ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding TimeChoice}"
                                          ItemTemplate="{StaticResource FormatChoiceTemplate}" AutomationProperties.Name="Time format"/>
                                <StackPanel Visibility="{Binding IsCustomTime, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding CustomTimePattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                                             AutomationProperties.Name="Custom time pattern"/>
                                    <TextBlock Text="{Binding TimeError}" Style="{StaticResource Error}"
                                               Visibility="{Binding TimeError, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                </StackPanel>

                                <Button Content="Use Windows' format" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                                        Margin="0,16,0,0" Command="{Binding ResetFormatCommand}"
                                        ToolTip="The short date and short time set in Windows' region settings"/>
                            </StackPanel>
                        </Border>

                        <!-- How to write a pattern, while one is being typed -->
                        <Border Style="{StaticResource Group}" Visibility="{Binding ShowFormatCodes, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="PATTERN CODES" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Margin" Value="0,2,14,2"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="yyyy" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="year, 2026"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MM MMM MMMM" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="03, Mar, March"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="d dd" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="day, 5 or 05"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ddd dddd" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Wed, Wednesday"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="'text'" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="shown as typed"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="HH" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="hour 00-23"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="h hh" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="hour 1-12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="minutes"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="ss" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="seconds"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="tt" Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="AM or PM"/>
                                </Grid>
                                <Button Content="Every code, on Microsoft Learn" Style="{StaticResource TextLink}" Margin="0,8,0,0"
                                        Command="{Binding OpenLinkCommand}" CommandParameter="{Binding FormatCodesUrl}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <!-- GitHub account: the same sign-in as the header's -->
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="GITHUB ACCOUNT" Style="{StaticResource SectionLabel}"/>
                                <DockPanel Visibility="{Binding GitHub.Login, Converter={StaticResource NullToVisibility}}">
                                    <Button DockPanel.Dock="Right" Content="Sign out" Style="{StaticResource Button.Secondary}" Margin="0"
                                            Command="{Binding GitHub.SignOutCommand}"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="14" Height="14"
                                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="Signed in as" Foreground="{StaticResource Text.Secondary}"/>
                                            <Run Text="{Binding GitHub.Login, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Visibility="{Binding GitHub.Login, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="0" Click="SignIn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GitHubMark}" Fill="{StaticResource Text.Primary}" Width="14" Height="14"
                                                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Sign in with GitHub"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Not signed in" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="Only Repos on this PC, Clone from GitHub and Create Pull Request use it. The sign-in is encrypted for your Windows account."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="OPEN-IN APPS" Style="{StaticResource SectionLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Edit…" Style="{StaticResource Button.Secondary}" Margin="0"
                                            Click="EditOpenWithApps_Click"/>
                                    <TextBlock Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="{Binding OpenWithApps.Count, StringFormat='{}Programs of your own under OPEN IN, beside Explorer and the IDEs ({0} added)'}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Only the installed app has an icon of its own to put on the desktop -->
                        <Border Style="{StaticResource Group}" Visibility="{Binding CanHaveDesktopIcon, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="DESKTOP ICON" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="There's a Repo'N'Launcher icon on your desktop." Foreground="{StaticResource Text.Secondary}"
                                           Visibility="{Binding HasDesktopIcon, Converter={StaticResource BoolToVisibility}}"/>
                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDesktopIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Button DockPanel.Dock="Right" Content="Create desktop icon" Style="{StaticResource Button.Secondary}" Margin="0"
                                            Command="{Binding CreateDesktopIconCommand}"/>
                                    <TextBlock Text="It's in the Start menu. It can have an icon on your desktop too." Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DesktopIconError}" Style="{StaticResource Error}"
                                           Visibility="{Binding DesktopIconError, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="SETTINGS FOLDER" Style="{StaticResource SectionLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Open folder" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                            Command="{Binding OpenSettingsFolderCommand}"/>
                                    <TextBlock Text="{Binding SettingsFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SettingsFolder}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="config.json keeps your projects and settings, github-sign-in.dat the encrypted GitHub sign-in."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}" Visibility="{Binding Updates.CanUninstall, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="UNINSTALL" Style="{StaticResource SectionLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Uninstall…" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"
                                            Click="Uninstall_Click"/>
                                    <TextBlock Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="Removes the app and everything it keeps on this PC. Your projects' own folders stay as they are."/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The dashboard browser: where sites open, what it keeps, and its ad blocker -->
            <TabItem Header="Browser">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" DataContext="{Binding SiteBrowser}">
                        <!-- Where a project's site opens: the same choice as the Run tab's Open in -->
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="SITES" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Open a project's local site (http://localhost:…) in" Foreground="{StaticResource Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ComboBox Height="32" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                          DropDownOpened="SiteTargets_DropDownOpened" AutomationProperties.Name="Open sites in"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="The dashboard browser is a window of the dashboard's own. The default browser is the one Windows opens links in (Windows' Settings &gt; Apps &gt; Default apps). It's the same as Open in, in a project's Run tab; right-click a site's address there to open it the other way, just that once."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="SEARCH" Style="{StaticResource SectionLabel}"/>
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" Height="32" Width="170" ItemsSource="{Binding SearchEngines}"
                                              SelectedItem="{Binding SearchEngine}" AutomationProperties.Name="Search with"/>
                                    <TextBlock Text="Search what's typed in the address with" Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="What looks like an address goes there: localhost:3000, 192.168.1.5, example.com, or anything starting https://. Everything else, such as react hooks or next.js, is searched for."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="BROWSING DATA" Style="{StaticResource SectionLabel}"/>
                                <RadioButton GroupName="BrowsingData" Margin="0,0,0,8"
                                             IsChecked="{Binding IsIncognito, Converter={StaticResource InverseBoolean}}" AutomationProperties.Name="Remember">
                                    <StackPanel>
                                        <TextBlock Text="Remember"/>
                                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                                   Text="History, cookies and sign-ins, form entries, site storage and the cache are kept on this PC, so sites stay signed in."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="BrowsingData" IsChecked="{Binding IsIncognito}" AutomationProperties.Name="Incognito">
                                    <StackPanel>
                                        <TextBlock Text="Incognito"/>
                                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                                   Text="Nothing is kept on this PC: all of it is forgotten once every browser window is closed."/>
                                    </StackPanel>
                                </RadioButton>
                                <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                           Text="It applies to browser windows opened from now on; open ones keep theirs until they're closed."/>
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Content="Clear browsing data" Style="{StaticResource Button.Secondary}"
                                            Margin="8,0,0,0" VerticalAlignment="Top" Command="{Binding ClearBrowsingDataCommand}"/>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                                   Text="Clears everything it has kept so far, which signs you out of sites."/>
                                        <TextBlock Text="{Binding ClearStatus}" Style="{StaticResource Note}" Margin="0,4,0,0"
                                                   Visibility="{Binding ClearStatus, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}" DataContext="{Binding AdBlocker}">
                            <StackPanel>
                                <TextBlock Text="AD BLOCKER" Style="{StaticResource SectionLabel}"/>
                                <CheckBox Content="Block ads in the dashboard browser" IsChecked="{Binding IsEnabled}"/>

                                <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsEnabled}">
                                    <TextBlock Text="Strength" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,6"/>
                                    <RadioButton GroupName="AdBlockLevel" Margin="0,0,0,8"
                                                 IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" AutomationProperties.Name="Light">
                                        <StackPanel>
                                            <TextBlock Text="Light"/>
                                            <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                                       Text="Ad servers only (EasyList's). Pages keep their layout, with gaps where ads were."/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="AdBlockLevel" Margin="0,0,0,8"
                                                 IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}" AutomationProperties.Name="Balanced">
                                        <StackPanel>
                                            <TextBlock Text="Balanced"/>
                                            <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                                       Text="Ads and trackers (EasyList and EasyPrivacy), with the spaces left for ads hidden."/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="AdBlockLevel"
                                                 IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Strict}" AutomationProperties.Name="Strict">
                                        <StackPanel>
                                            <TextBlock Text="Strict"/>
                                            <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                                       Text="Also cookie banners and social widgets (Fanboy's Annoyance list), more ad and tracker servers (Peter Lowe's list), and pop-ups a page opens without a click. Can break some sites."/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0"
                                           Text="Sites on this PC or its network, such as localhost:3000, aren't filtered: they're your own projects. To let a site show its ads until the app closes, press the shield beside a browser window's address and Pause on it."/>

                                <!-- The sites it's paused on, until the app closes -->
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PausedSites.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Paused until the app closes on" Foreground="{StaticResource Text.Secondary}" FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding PausedSites}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Content="Resume" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Right" Content="Update now" Style="{StaticResource Button.Secondary}"
                                            Margin="8,0,0,0" VerticalAlignment="Top" Command="{Binding UpdateListsCommand}"/>
                                    <StackPanel>
                                        <TextBlock Text="Filter lists" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding ListsStatus}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                           Text="Downloaded from easylist.to and pgl.yoyo.org, and again once they're 4 days old."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The same as the Android emulators window -->
            <TabItem Header="Emulators">
                <controls:EmulatorsPanel DataContext="{Binding Emulators}" Margin="0,4,6,0"/>
            </TabItem>

            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0" DataContext="{Binding Updates}">
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="VERSION" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Check for updates" Style="{StaticResource Button.Secondary}" Command="{Binding CheckCommand}"
                                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="Restart to update" Style="{StaticResource Button.Primary}" Command="{Binding RestartCommand}"
                                            Visibility="{Binding ReadyVersion, Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0"
                                           Text="The installed app checks for a new version when it starts and every 4 hours, downloads it in the background, then offers Restart to update. If you don't restart, it's applied the next time the app starts."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock Text="RELEASES" Style="{StaticResource SectionLabel}"/>
                                <Button Content="What's new in each version, on GitHub" Style="{StaticResource TextLink}"
                                        Command="{Binding DataContext.OpenLinkCommand, ElementName=Tabs}"
                                        CommandParameter="{Binding DataContext.ReleasesUrl, ElementName=Tabs}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <Border Style="{StaticResource Group}">
                            <StackPanel>
                                <TextBlock FontSize="18"
                                    ><Run Text="C:\" Foreground="{StaticResource Text.Muted}"
                                    /><Run Text="{Binding AppName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                    /><Run Text="&gt;_" Foreground="{StaticResource Text.Muted}"/></TextBlock>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Group}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="VERSION" Style="{StaticResource RowLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Updates.VersionText}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="AUTHOR" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Author}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="{Binding AuthorHandle}" Style="{StaticResource TextLink}" VerticalAlignment="Center"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="{Binding AuthorUrl}" ToolTip="{Binding AuthorUrl}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="SOURCE" Style="{StaticResource RowLabel}"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="{Binding RepoText}" Style="{StaticResource TextLink}" VerticalAlignment="Center"
                                        Command="{Binding OpenLinkCommand}" CommandParameter="{Binding RepoUrl}" ToolTip="Open the dashboard's repo on GitHub"/>

                                <TextBlock Grid.Row="3" Text="FEEDBACK" Style="{StaticResource RowLabel}"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="Report a problem or ask for a feature" Style="{StaticResource TextLink}"
                                        VerticalAlignment="Center" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding IssuesUrl}"
                                        ToolTip="{Binding IssuesUrl}"/>

                                <TextBlock Grid.Row="4" Text="LICENSE" Style="{StaticResource RowLabel}"/>
                                <Button Grid.Row="4" Grid.Column="1" Content="{Binding License}" Style="{StaticResource TextLink}" VerticalAlignment="Center"
                                        Command="{Binding OpenLinkCommand}" CommandParameter="{Binding LicenseUrl}" ToolTip="{Binding LicenseUrl}"/>

                                <TextBlock Grid.Row="5" Text="RUNS ON" Style="{StaticResource RowLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Runtime}" Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Copy version info" Style="{StaticResource Button.Secondary}" Command="{Binding CopyVersionInfoCommand}"
                                    ToolTip="The version and what it runs on, to paste into a bug report"/>
                            <TextBlock Text="{Binding CopyNote}" Foreground="{StaticResource Text.Muted}" FontSize="12" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Note}" Margin="0,16,0,0"
                                   Text="Phone screen mirroring uses scrcpy by Genymobile. Maps and place search are OpenStreetMap's. Updates come through Velopack."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
