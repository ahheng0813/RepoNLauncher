<Application x:Class="RepoNLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RepoNLauncher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The colors: Services\ThemeService.cs swaps this for Palette.Light.xaml -->
                <ResourceDictionary Source="Theme/Palette.Dark.xaml"/>
                <ResourceDictionary Source="Theme/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
