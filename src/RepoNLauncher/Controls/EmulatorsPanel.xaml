<UserControl x:Class="RepoNLauncher.Controls.EmulatorsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RepoNLauncher.Converters">

    <!-- The emulators on this PC and making a new one, on an EmulatorsViewModel: in the Android emulators window and in
         Settings > Emulators -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="RowState" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="&#xE72C;" Style="{StaticResource Button.Ghost}" Margin="0"
                    ToolTip="Refresh" AutomationProperties.Name="Refresh emulators" Click="Refresh_Click"/>
            <TextBlock Text="ON THIS PC" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                       Visibility="{Binding CanUseEmulators, Converter={StaticResource BoolToVisibility}}"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource Text.Secondary}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.Name="Emulators status"
                   Visibility="{Binding Status, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <!-- What's missing before emulators can be used -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="0" Padding="16,14"
                Visibility="{Binding SetupNote, Converter={StaticResource StringNotEmptyToVisibility}}">
            <TextBlock Text="{Binding SetupNote}" TextWrapping="Wrap"/>
        </Border>

        <!-- Create -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="0" Padding="16,14" Margin="0,14,0,0"
                Visibility="{Binding CanUseEmulators, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="CREATE AN EMULATOR" Style="{StaticResource SectionLabel}"/>

                <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,10,0,0"
                           Visibility="{Binding SelectedImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                           Text="It needs an Android system image, and none is installed. In Android Studio, open SDK Manager, then SDK Platforms, tick Show Package Details, and tick a Google Play x86_64 system image. Then press Refresh above."/>

                <Grid Margin="0,12,0,0" Visibility="{Binding SelectedImage, Converter={StaticResource NullToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource Text.Secondary}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Emulator name"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NameError}" Foreground="{StaticResource Danger}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,5,0,0"
                               Visibility="{Binding NameError, Converter={StaticResource StringNotEmptyToVisibility}}"/>

                    <TextBlock Grid.Row="2" Text="Device" VerticalAlignment="Center" Margin="0,10,16,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Label" AutomationProperties.Name="Device"/>

                    <TextBlock Grid.Row="3" Text="Android" VerticalAlignment="Center" Margin="0,10,16,0" Foreground="{StaticResource Text.Secondary}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Height="32" Margin="0,10,0,0" ItemsSource="{Binding Images}"
                              SelectedItem="{Binding SelectedImage}" DisplayMemberPath="Label" AutomationProperties.Name="System image"/>
                </Grid>

                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Content="Create emulator" Style="{StaticResource Button.Primary}" Margin="0"
                            Command="{Binding CreateCommand}"/>
                    <CheckBox Content="Start it now" IsChecked="{Binding StartAfterCreate}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- The emulators on this PC -->
        <DockPanel Visibility="{Binding CanUseEmulators, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Top" FontSize="12" Text="None yet. Create one below.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Emulators.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Emulators}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                                    CornerRadius="0" Padding="14,10" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <!-- What it's doing -->
                                        <TextBlock Text="Starting…" Style="{StaticResource RowState}"
                                                   Visibility="{Binding IsStarting, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="Shutting down…" Style="{StaticResource RowState}"
                                                   Visibility="{Binding IsStopping, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="Deleting…" Style="{StaticResource RowState}"
                                                   Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVisibility}}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Visibility="{Binding IsShownRunning, Converter={StaticResource BoolToVisibility}}">
                                            <Rectangle Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Running" Foreground="{StaticResource Text.Secondary}"/>
                                        </StackPanel>

                                        <Button Content="Start" Style="{StaticResource Button.Secondary}" Margin="0"
                                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Start {0}}"
                                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Shut down" Style="{StaticResource Button.Secondary}" Margin="0"
                                                ToolTip="Close it, as its window's close button does"
                                                Command="{Binding DataContext.ShutDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=Shut down {0}}"
                                                Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- While it's renamed: keep or drop the new name (Enter and Esc do the same) -->
                                        <Button Content="Save" Style="{StaticResource Button.Primary}" Margin="0"
                                                Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Save the new name"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Keep the old name"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"/>

                                        <Button Content="&#xE8AC;" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                ToolTip="Rename" AutomationProperties.Name="{Binding DisplayName, StringFormat=Rename {0}}"
                                                Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVisibility}}"
                                                IsEnabled="{Binding CanRename}"/>
                                        <Button Content="&#xE74D;" Margin="2,0,0,0" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Delete {0}}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVisibility}}"
                                                IsEnabled="{Binding CanDelete}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="ToolTip" Value="Delete it, with its apps and files"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="ToolTip" Value="Shut it down to delete it"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name, StringFormat=AVD name: {0}}"
                                                   Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="New name for the emulator"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_PreviewKeyDown"/>
                                        <TextBlock Text="{Binding RenameError}" Foreground="{StaticResource Danger}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding RenameError, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Note}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
