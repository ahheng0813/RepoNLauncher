<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The light palette: the same console look in dark text on paper white, like "color F0". Same keys as
         Palette.Dark.xaml. Accent turns near-black, so primary buttons and the open tab are a dark block with light text.
         The status colors are darker than the dark palette's so they read on white (4.5:1 or more on Bg.App). -->

    <SolidColorBrush x:Key="Bg.App" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Bg.Panel" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Bg.PanelAlt" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Bg.Hover" Color="#E4E4E4"/>
    <!-- The brightest background: text boxes, consoles, the phone screen's frame -->
    <SolidColorBrush x:Key="Bg.Console" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border.Subtle" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="Border.Control" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Border.Row" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#262626"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#505050"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#696969"/>
    <SolidColorBrush x:Key="Text.OnAccent" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Accent" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#000000"/>
    <SolidColorBrush x:Key="Accent.Pressed" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="Accent.Muted" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="Cyan" Color="#00727F"/>
    <SolidColorBrush x:Key="Cyan.Muted" Color="#DCEFF2"/>
    <SolidColorBrush x:Key="Success" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Warning" Color="#8A5300"/>
    <SolidColorBrush x:Key="Warning.Muted" Color="#F6EAD3"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Danger.Hover" Color="#A4231A"/>
    <SolidColorBrush x:Key="Danger.Muted" Color="#FBE5E3"/>
    <SolidColorBrush x:Key="Danger.Border" Color="#E3A39E"/>
    <SolidColorBrush x:Key="Danger.BorderSubtle" Color="#EEC7C3"/>
    <SolidColorBrush x:Key="Console.Selection" Color="#38000000"/>

    <SolidColorBrush x:Key="Kind.Flutter" Color="#0063B1"/>
    <SolidColorBrush x:Key="Kind.DotNet" Color="#8B2F99"/>

</ResourceDictionary>
